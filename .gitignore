.DS_Store
node_modules/
.wrangler/
.dev.vars

# Machine-local Claude Code settings, nothing shareable. launch.json points at
# a dev-server script under this machine's scratchpad, so it is broken anywhere
# else and carries a session id nobody needs.
.claude/settings.local.json
.claude/launch.json

# XcodeGen generates these from project.yml — not under version control.
ios/*.xcodeproj
# The development team, which is an Apple account identifier and stays out of
# HEAD (decided 10 Sep 2026). ios/Signing.xcconfig includes it when it exists.
ios/Signing.local.xcconfig
ios/Kinlore/Info.plist
ios/*.xcworkspace
xcuserdata/
DerivedData/
build/

# ASR test samples: real people's voices, not for the repo.
samples/

# Dumps of the production database (`npm run db:export` in backend/). Family
# and member names are plaintext in them. Never in the repo.
backend/backups/
