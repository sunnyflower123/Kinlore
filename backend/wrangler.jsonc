{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "memorize",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": ["nodejs_compat"],

	// Metadata: families, subjects, memories, relationships.
	//   npx wrangler d1 create memorize
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "memorize",
			"database_id": "TODO-run-wrangler-d1-create"
		}
	],

	// Photos and audio. The original audio is always kept, so this grows faster
	// than the photos — on R2 it is still effectively free.
	//   npx wrangler r2 bucket create memorize-media
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "memorize-media"
		}
	],

	// The only two routes that write without a member identity: creating a
	// family and joining one. Everything else needs an id, so these are the
	// doors an uninvited caller can knock on. See docs/ARCHITECTURE.md §4.
	//
	// `namespace_id` is ours to choose and only has to be unique within this
	// Worker. `period` accepts 10 or 60 and nothing else.
	//
	// The limits are per IP and are set for a family behind one home router,
	// not for one phone: joining is a thing a person does once, and five
	// families a minute from one address is already nobody's real evening.
	"ratelimits": [
		{
			"name": "FAMILY_JOIN_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "FAMILY_CREATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	],

	"vars": {
		// Free tier limits. Photos and AI minutes are limited — writing
		// memories never is, see rule 2 in CLAUDE.md.
		"FREE_PHOTO_LIMIT": "20",
		"FREE_AI_SECONDS_PER_MONTH": "600",
		"RC_ENTITLEMENT_ID": "archive",
		// The project identifier from the RevenueCat dashboard. Not a secret,
		// unlike RC_SECRET_KEY and RC_WEBHOOK_SECRET.
		"RC_PROJECT_ID": "TODO-revenuecat-project-id",

		// The models were CHOSEN BY MEASUREMENT, not from memory:
		// scripts/asr-bench.mjs, 3 texts × 4 degradation steps × 5 models.
		//
		//   gemini-3.6-flash        WER 37.8 %   proper nouns 68 %   ← chosen
		//   gemini-3.1-flash-lite   WER 43.9 %   proper nouns 49 %
		//   gpt-audio-mini          WER 58.7 %   proper nouns 57 %   (rejects m4a)
		//   gemini-2.5-flash        WER 13,530 % proper nouns 33 %   (hallucinates)
		//   voxtral-small           fails on audio input entirely
		//
		// Proper-noun accuracy weighs more than WER: the family tree is built
		// out of names.
		"MODEL_EXTRACT": "google/gemini-3.6-flash",
		// The third attempt switches model: the measured fault was in the
		// provider (finish_reason=error), and the same model again does not help.
		"MODEL_EXTRACT_FALLBACK": "openai/gpt-4o-mini",
		"MODEL_TRANSCRIBE": "google/gemini-3.6-flash"
	},

	"observability": { "enabled": true }
}
