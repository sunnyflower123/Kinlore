{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "memorize",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": ["nodejs_compat"],

	// Metadata: families, subjects, memories, relationships.
	//   npx wrangler d1 create memorize
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "memorize",
			"database_id": "a39d23ba-234b-4045-8fd6-25ebf8210b0d"
		}
	],

	// Photos and audio. The original audio is always kept, so this grows faster
	// than the photos — on R2 it is still effectively free.
	//   npx wrangler r2 bucket create memorize-media
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "memorize-media"
		}
	],

	// The only two routes that write without a member identity: creating a
	// family and joining one. Everything else needs an id, so these are the
	// doors an uninvited caller can knock on. See docs/ARCHITECTURE.md §4.
	//
	// `namespace_id` is ours to choose and only has to be unique within this
	// Worker. `period` accepts 10 or 60 and nothing else.
	//
	// The limits are per IP and are set for a family behind one home router,
	// not for one phone: joining is a thing a person does once, and five
	// families a minute from one address is already nobody's real evening.
	"ratelimits": [
		{
			"name": "FAMILY_JOIN_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "FAMILY_CREATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	],

	"vars": {
		// Free tier limits. Photos, AI minutes and colourisations are limited —
		// writing memories never is, see rule 2 in CLAUDE.md.
		"FREE_PHOTO_LIMIT": "20",
		"FREE_AI_SECONDS_PER_MONTH": "600",
		"FREE_COLOURISATIONS_PER_MONTH": "5",
		"RC_ENTITLEMENT_ID": "archive",
		// The project identifier from the RevenueCat dashboard. Not a secret,
		// unlike RC_SECRET_KEY and RC_WEBHOOK_SECRET.
		"RC_PROJECT_ID": "proj087f04ef",

		// The models were CHOSEN BY MEASUREMENT, not from memory:
		// scripts/asr-bench.mjs, 3 texts × 4 degradation steps × 5 models, in
		// BOTH languages since 30 Aug 2026 — the same voice family, rate and
		// degradation in each, which is what makes the two columns comparable.
		//
		//                           Finnish              English
		//   gemini-3.6-flash        37.3 %  names 65 %   29.9 %  names 60 %  ← chosen
		//   gemini-3.1-flash-lite   44.7 %  names 51 %   31.2 %  names 63 %
		//   gpt-audio-mini          46.9 %  names 49 %   4 011 % names 68 %
		//   gemini-2.5-flash        13 533 % names 25 %  27.4 %  names 58 %
		//   voxtral-small           fails on audio input entirely
		//
		// Proper-noun accuracy weighs more than WER: the family tree is built
		// out of names.
		//
		// THE RANKING IS NOT THE SAME IN THE TWO LANGUAGES, and that is the
		// finding this run was for — assuming it carried over is exactly what
		// PLAN.md §10 said could not be assumed. On English, gemini-2.5-flash
		// leads on WER and gemini-3.1-flash-lite on names; the chosen model is
		// second on one and third on the other.
		//
		// It is chosen anyway, and not out of inertia. Both of those leaders
		// blow up in the other language: gemini-2.5-flash produces 13 533 % on
		// Finnish and gpt-audio-mini 4 011 % on English, which is the wall of
		// invented text this app fears most — an engine that does it in one
		// language will do it in the other on the day the audio is bad enough.
		// Only gemini-3.6-flash is sane in both, and its gaps to the leaders,
		// 2.5 points of WER and 3 of recall over twelve samples each, are inside
		// the noise of a sample set this size.
		//
		// English scores BETTER than Finnish here, on the same method: 29.9 %
		// against 37.3 %. That is not a compliment to the English pipeline, it
		// is the size of the training sets talking.
		//
		// Both columns are synthetic. Neither answers whether the concept works
		// on a real elderly voice — see PLAN.md §8, and the bench says so on
		// every run.
		"MODEL_EXTRACT": "google/gemini-3.6-flash",
		// The third attempt switches model: the measured fault was in the
		// provider (finish_reason=error), and the same model again does not help.
		"MODEL_EXTRACT_FALLBACK": "openai/gpt-4o-mini",
		"MODEL_TRANSCRIBE": "google/gemini-3.6-flash",

		// Colouring a photograph by what the family told about it. Chosen by
		// measurement as well, 13 Sep 2026: one synthetic 1950s photograph, the
		// same instruction and Finnish telling, through chat completions with
		// rule 8's deny, each cost read from the reply's own `usage.cost`:
		//
		//                                cost    edges   faces     told colours
		//   gemini-3.1-flash-lite-image  3.39 c  0.971   the same  followed  ← chosen
		//   gemini-3.1-flash-image       6.78 c  0.964   the same  followed
		//   gemini-2.5-flash-image       3.94 c  0.683   the same  followed; boots changed
		//   gpt-5-image-mini             4.87 c  0.125   REDRAWN   followed; square frame
		//
		// "Edges" is the correlation of the reply's edge map with the original's,
		// unshifted, where 1 is every edge in place; "faces" is by eye. The last
		// row is the reason it is measured rather than read off a price list: that
		// model repainted the grandmother as somebody else, and charged more for
		// it than the chosen one.
		//
		// The lite model spread the told red of the house onto a window frame and a
		// cardigan nobody mentioned, where flash kept them apart. At half the price
		// a correcting second round costs what one flash round does. One photograph
		// is not a sample.
		"MODEL_COLOURISE": "google/gemini-3.1-flash-lite-image"
	},

	"observability": { "enabled": true }
}
